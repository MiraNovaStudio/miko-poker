{
  "name": "@miko/engine",
  "version": "0.6.1",
  "description": "Pure TypeScript Texas Hold'em engine for MikoPoker (UI-agnostic).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "rimraf": "^6",
    "typescript": "^5",
    "vitest": "^2"
  },
  "keywords": ["poker", "holdem", "engine", "typescript", "game-logic"]
}
